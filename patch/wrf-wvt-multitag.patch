+! tracer array, so tag 1 sums in the same order as calc_moist_fluxes did)
+
+SUBROUTINE calc_tracer_moist_fluxes( dt, itimestep, tracer, n_tracer, tag,  &
+                                     thum_u_phy_dt, thum_v_phy_dt,          &
+                                     u_phy, v_phy,                          &
+                                     ids, ide, jds, jde, kds, kde,          &
+                                     ims, ime, jms, jme, kms, kme,          &
+                                     its, ite, jts, jte, kts, kte  )
+
+   USE module_wvt_tags, ONLY : wvt_tag_t
+
+   IMPLICIT NONE
+
+   INTEGER ,          INTENT(IN   ) :: ids, ide, jds, jde, kds, kde, &
+                                       ims, ime, jms, jme, kms, kme, &
+                                       its, ite, jts, jte, kts, kte
+   INTEGER ,          INTENT(IN   ) :: n_tracer, itimestep
+   REAL ,             INTENT(IN   ) :: dt
+   REAL, DIMENSION( ims:ime , kms:kme , jms:jme , n_tracer ), INTENT(IN   ) :: tracer
+   TYPE(wvt_tag_t),   INTENT(IN   ) :: tag
+   REAL, DIMENSION( ims:ime , kms:kme , jms:jme ) , INTENT(IN   ) :: u_phy, v_phy
+   REAL, DIMENSION( ims:ime , kms:kme , jms:jme ) , INTENT(INOUT) :: thum_u_phy_dt, thum_v_phy_dt
+
+   REAL :: thum
+   INTEGER :: i, j, k, itf, jtf, ktf
+
+     itf=MIN(ite,ide-1)
+     jtf=MIN(jte,jde-1)
+     ktf=MIN(kte,kde-1)
+
+     IF (itimestep == 1) THEN
+       DO j=jts,jtf
+       DO k=kts,ktf
+       DO i=its,itf
+            thum_u_phy_dt(i,k,j)=0.
+            thum_v_phy_dt(i,k,j)=0.
+       ENDDO
+       ENDDO
+       ENDDO
+     END IF
+
+     DO j=jts,jtf
+     DO k=kts,ktf
+     DO i=its,itf
+        thum = 0.
+        thum = thum + tracer(i,k,j,tag%p_qv)
+        thum = thum + tracer(i,k,j,tag%p_qc)
+        thum = thum + tracer(i,k,j,tag%p_qr)
+        thum = thum + tracer(i,k,j,tag%p_qi)
+        thum = thum + tracer(i,k,j,tag%p_qs)
+        thum = thum + tracer(i,k,j,tag%p_qg)
+        thum_u_phy_dt(i,k,j)=thum_u_phy_dt(i,k,j)+thum*u_phy(i,k,j)*dt
+        thum_v_phy_dt(i,k,j)=thum_v_phy_dt(i,k,j)+thum*v_phy(i,k,j)*dt
+     ENDDO
+     ENDDO
+     ENDDO
+
+END SUBROUTINE calc_tracer_moist_fluxes
+
