+!WRF:MODEL_LAYER:
+!
+! Multi-tag WRF-WVTs: point the tag table (share/module_wvt_tags.F) at the
+! fields of the grid being integrated.  Called at the start of start_domain_em
+! and solve_em, so the physics drivers always see the current grid's tags.
+!
+MODULE module_wvt_set
+
+CONTAINS
+
+   SUBROUTINE wvt_set_tags ( grid, config_flags )
+
+      USE module_domain, ONLY : domain, get_ijk_from_grid
+      USE module_configure, ONLY : grid_config_rec_type
+      USE module_state_description
+      USE module_wvt_tags
+
+      IMPLICIT NONE
+
+      TYPE(domain), INTENT(INOUT), TARGET :: grid
+      TYPE(grid_config_rec_type), INTENT(IN) :: config_flags
+
+      INTEGER :: it
+      INTEGER :: ids, ide, jds, jde, kds, kde, &
+                 ims, ime, jms, jme, kms, kme, &
+                 ips, ipe, jps, jpe, kps, kpe
+
+      wvt_ntag = wvt_ntags_of( config_flags%tracer_opt )
+      IF ( wvt_ntag == 0 ) RETURN
+
+      CALL get_ijk_from_grid ( grid ,                   &
+                               ids, ide, jds, jde, kds, kde,    &
+                               ims, ime, jms, jme, kms, kme,    &
+                               ips, ipe, jps, jpe, kps, kpe    )
+
+      DO it = 1, wvt_ntag
+#include "wvt_tags_set.h"
+         IF ( wvt(it)%p_qv < PARAM_FIRST_SCALAR ) CALL wrf_error_fatal( &
+            'wvt_set_tags: tracer species of a requested tag are not allocated (check tracer_opt)' )
+         wvt(it)%qv(ims:,kms:,jms:) => grid%tracer(:,:,:,wvt(it)%p_qv)
+         wvt(it)%qc(ims:,kms:,jms:) => grid%tracer(:,:,:,wvt(it)%p_qc)
+         wvt(it)%qr(ims:,kms:,jms:) => grid%tracer(:,:,:,wvt(it)%p_qr)
+         wvt(it)%qi(ims:,kms:,jms:) => grid%tracer(:,:,:,wvt(it)%p_qi)
+         wvt(it)%qs(ims:,kms:,jms:) => grid%tracer(:,:,:,wvt(it)%p_qs)
+         wvt(it)%qg(ims:,kms:,jms:) => grid%tracer(:,:,:,wvt(it)%p_qg)
+      ENDDO
+
+   END SUBROUTINE wvt_set_tags
+
+   ! cold start: zero tags 2..N where the physics inits zero tag 1
+   ! (mp_init: TR_*NC, cu_init/kf_eta_init_tr: TR_RAINC and RTRQ*CUTEN,
+   ! ysuinit_tr: RTRQ*BLTEN).  The masks and tracer species come from input.
+   SUBROUTINE wvt_zero_extra_tags
+
+      USE module_wvt_tags
+
+      IMPLICIT NONE
+
+      INTEGER :: it
+
+      DO it = 2, wvt_ntag
+         wvt(it)%rtrqvblten = 0. ; wvt(it)%rtrqcblten = 0. ; wvt(it)%rtrqiblten = 0.
+         wvt(it)%rtrqvcuten = 0. ; wvt(it)%rtrqrcuten = 0. ; wvt(it)%rtrqccuten = 0.
+         wvt(it)%rtrqscuten = 0. ; wvt(it)%rtrqicuten = 0.
+         wvt(it)%trqfx      = 0. ; wvt(it)%tr_pratec  = 0.
+         wvt(it)%tr_rainnc  = 0. ; wvt(it)%tr_snownc  = 0. ; wvt(it)%tr_graupelnc = 0.
+         wvt(it)%tr_rainc   = 0.
+         wvt(it)%tr_thum_u_phy_dt = 0. ; wvt(it)%tr_thum_v_phy_dt = 0.
+      ENDDO
+
+   END SUBROUTINE wvt_zero_extra_tags
+
+END MODULE module_wvt_set
