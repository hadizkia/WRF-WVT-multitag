+!WRF:MEDIATION_LAYER:
+!
+! Multi-tag WRF-WVTs: table of the per-tag moisture-tracer fields.
+!
+!   tracer_opt = 4        1 tag  (original WRF-WVTs: qv_tr, TRMASK, ...)
+!   tracer_opt = 40 + N   N tags (N = 2..wvt_max_tags); tag t >= 2 uses the
+!                         fields with a _t<t> suffix (qv_tr_t2, TRMASK_T2, ...)
+!
+! Tag 1 keeps going through the original WRF-WVTs argument lists everywhere.
+! Tags 2..N are handled next to each tag-1 hook through this table, which
+! wvt_set_tags (dyn_em/module_wvt_set.F) points at the current grid's fields.
+! A tag never feeds back on the model or on another tag, so tags 2..N give
+! exactly what N separate single-tag runs would give.
+!
+MODULE module_wvt_tags
+
+   IMPLICIT NONE
+
+! generated by tools/wvt_multitag (named .h: ./clean deletes *.inc)
+#include "wvt_max_tags.h"
+
+   TYPE wvt_tag_t
+      ! indices of this tag's six species in the 4D tracer array
+      INTEGER :: p_qv = 1, p_qc = 1, p_qr = 1, p_qi = 1, p_qs = 1, p_qg = 1
+      ! this tag's species, pointing into grid%tracer (memory bounds kept)
+      REAL, DIMENSION(:,:,:), POINTER :: qv => NULL(), qc => NULL(), qr => NULL(), &
+                                         qi => NULL(), qs => NULL(), qg => NULL()
+      ! this tag's copies of the fields in Registry/registry.moisttracers
+      REAL, DIMENSION(:,:,:), POINTER :: rtrqvblten => NULL(), rtrqcblten => NULL(),   &
+                                         rtrqiblten => NULL(), rtrqvcuten => NULL(),   &
+                                         rtrqrcuten => NULL(), rtrqccuten => NULL(),   &
+                                         rtrqscuten => NULL(), rtrqicuten => NULL(),   &
+                                         trmask3d => NULL(), trmask3d2 => NULL(),      &
+                                         tr_thum_u_phy_dt => NULL(), tr_thum_v_phy_dt => NULL()
+      REAL, DIMENSION(:,:),   POINTER :: trqfx => NULL(), trmask => NULL(),            &
+                                         tr_rainnc => NULL(), tr_snownc => NULL(),     &
+                                         tr_graupelnc => NULL(), tr_rainc => NULL(),   &
+                                         tr_pratec => NULL()
+   END TYPE wvt_tag_t
+
+   ! number of tags of the grid currently set by wvt_set_tags (0 = WVT off)
+   INTEGER, SAVE :: wvt_ntag = 0
+   TYPE(wvt_tag_t), DIMENSION(wvt_max_tags), SAVE, TARGET :: wvt
+
+CONTAINS
+
+   ! number of moisture tags selected by tracer_opt (0 = WRF-WVTs off)
+   INTEGER FUNCTION wvt_ntags_of ( tracer_opt )
+      INTEGER, INTENT(IN) :: tracer_opt
+      wvt_ntags_of = 0
+      IF ( tracer_opt == 4 ) THEN
+         wvt_ntags_of = 1
+      ELSE IF ( tracer_opt >= 42 .AND. tracer_opt <= 40 + wvt_max_tags ) THEN
+         wvt_ntags_of = tracer_opt - 40
+      END IF
+   END FUNCTION wvt_ntags_of
+
+   ! extra tags (2..N) are handled by copying the scheme inputs, which assumes
+   ! one tile per patch (dmpar build, no OpenMP tiling)
+   SUBROUTINE wvt_check_tiles ( num_tiles )
+      INTEGER, INTENT(IN) :: num_tiles
+      IF ( wvt_ntag > 1 .AND. num_tiles > 1 ) CALL wrf_error_fatal( &
+         'multi-tag WVT (tracer_opt > 40) needs one tile per patch: run without OpenMP tiling (numtiles = 1)' )
+   END SUBROUTINE wvt_check_tiles
+
+END MODULE module_wvt_tags
